# Copy to .env and fill in your own values. Never commit .env.

# --- App under test (required by e2e/helpers/flexplus.ts and scripts/preflight.js) ---
APP_URL=
APP_USERNAME=
APP_PASSWORD=

# --- TestRail (only needed for upload-testrail.js / testrail-formatter UPLOAD) ---
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SECTION_ID=

# --- Confluence (only needed for update-confluence.js) ---
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAGE_ID=

GITHUB_REPO_OWNER=

# --- Corporate proxy CA (optional; path to your own bundle) ---
SSL_CERT_FILE=
NODE_EXTRA_CA_CERTS=

# --- Optional test-data fixtures used by some generated specs ---
# QA_EMAIL=
# QA_PASSWORD=
