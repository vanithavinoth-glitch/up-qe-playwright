{
  "name": "qe-automation-orchestrator",
  "version": "1.0.0",
  "description": "Playwright test suite orchestrated by LangGraph multi-agent pipeline",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "qa:validate-journeys": "node scripts/validate-journeys.js",
    "qa:lint-specs": "node scripts/lint-specs.js",
    "qa:coverage": "node scripts/update-coverage.js",
    "test:flexplus": "playwright test --project=flexplus",
    "qa:preflight": "node scripts/preflight.js"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.25",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
